<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos para Firebase, Retrofit y Glide (PokéAPI) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Permiso recomendado para notificaciones en Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">

        <!-- Splash Screen (Pantalla de inicio principal) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Módulo de Autenticación -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false" />

        <!-- Navegación Principal y Perfil -->
        <activity
            android:name=".MainMenuActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".PerfilActivity"
            android:exported="false" />

        <!-- Módulos de la Aplicación -->
        <activity
            android:name=".PokedexActivity"
            android:exported="false" />

        <activity
            android:name=".BattleEmulatorActivity"
            android:exported="false" />

        <activity
            android:name=".BattleVersusActivity"
            android:exported="false" />

        <activity
            android:name=".TorrePokemonActivity"
            android:exported="false" />

        <activity
            android:name=".QuienEsPokemonActivity"
            android:exported="false" />

        <activity
            android:name=".ZonaSafariActivity"
            android:exported="false" />

        <activity
            android:name=".MaestroTiposActivity"
            android:exported="false" />

        <activity
            android:name=".TorrePokemonActivity"
            android:exported="false" />

        <activity
            android:name=".FavoritosActivity"
            android:exported="false" />

        <activity
            android:name=".HistorialActivity"
            android:exported="false" />

        <activity
            android:name=".MedallasActivity"
            android:exported="false" />

        <activity
            android:name=".ConfiguracionActivity"
            android:exported="false" />

    </application>

</manifest>