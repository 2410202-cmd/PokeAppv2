<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_whos_that_pokemon">

    <!-- MARCADOR DE PUNTOS SUPERIOR -->
    <LinearLayout
        android:id="@+id/scoreContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="#CC0F172A"
        android:orientation="horizontal"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SCORE: 0"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStreak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Racha: 0"
            android:textColor="#F43F5E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ÁREA CENTRAL DE LA SILUETA (ALINEADA CON EL DESTELLO AZUL) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/optionsContainer"
        android:layout_below="@id/scoreContainer">

        <ImageView
            android:id="@+id/ivPokemonSilhouette"
            android:layout_width="220dp"
            android:layout_height="220dp"
            android:layout_centerInParent="true"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tvPokemonNameResult"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/ivPokemonSilhouette"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:background="#D90F172A"
            android:paddingHorizontal="16dp"
            android:paddingVertical="4dp"
            android:text="¿ ? ?"
            android:textColor="#FACC15"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- CONTENEDOR INFERIOR DE 4 OPCIONES + BOTÓN SALTAR -->
    <LinearLayout
        android:id="@+id/optionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#D9000000"
        android:orientation="vertical"
        android:padding="12dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/btnOption1"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="#0284C7"
                android:text="OPCIÓN 1"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOption2"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="#0284C7"
                android:text="OPCIÓN 2"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOption3"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="#0284C7"
                android:text="OPCIÓN 3"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

            <Button
                android:id="@+id/btnOption4"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:backgroundTint="#0284C7"
                android:text="OPCIÓN 4"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </GridLayout>

        <Button
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="4dp"
            android:backgroundTint="#475569"
            android:text="⏩ SALTAR POKÉMON"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="10dp" />
    </LinearLayout>

</RelativeLayout>