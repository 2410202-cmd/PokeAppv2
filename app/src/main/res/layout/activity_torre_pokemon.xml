<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:padding="16dp">

    <!-- HEADER: PISO ACTUAL DE LA TORRE -->
    <LinearLayout
        android:id="@+id/llHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/pokemon_font"
            android:text="TORRE POKEMON"
            android:textColor="#FACC15"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFloorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/clean_card_bg"
            android:fontFamily="@font/pokemon_font"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="PISO: 1"
            android:textColor="#EC4899"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ARENA DE COMBATE CONTRA JEFE -->
    <LinearLayout
        android:id="@+id/llBattleArena"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_below="@id/llHeader"
        android:layout_marginTop="12dp"
        android:background="@drawable/clean_card_bg"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- PROFESOR (JEFE ENEMIGO) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvBossTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_font"
                    android:text="PROFE VÍCTOR"
                    android:textColor="#F43F5E"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/pbEnemyHp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#22C55E" />

                <TextView
                    android:id="@+id/tvEnemyHpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="100/100 HP"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivEnemySprite"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true" />
        </RelativeLayout>

        <!-- TU POKÉMON -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/ivPlayerSprite"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true" />

            <LinearLayout
                android:layout_width="170dp"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="#1E293B"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tvPlayerName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pokemon_font"
                    android:text="TU POKEMON"
                    android:textColor="#38BDF8"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/pbPlayerHp"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="100"
                    android:progressTint="#22C55E" />

                <TextView
                    android:id="@+id/tvPlayerHpText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="100/100 HP"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- NARRADOR DE COMBATE -->
    <TextView
        android:id="@+id/tvBattleLog"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_below="@id/llBattleArena"
        android:layout_marginTop="10dp"
        android:background="#1E293B"
        android:gravity="center"
        android:padding="8dp"
        android:text="¡Desafía a los Profesores!"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <!-- CONTROLES -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <Button
            android:id="@+id/btnSelectPokemon"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginBottom="8dp"
            android:backgroundTint="#FACC15"
            android:fontFamily="@font/pokemon_font"
            android:text="Elegir mi Pokemon"
            android:textColor="#090D16"
            android:textSize="12sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:columnCount="2"
            android:rowCount="2">

            <Button
                android:id="@+id/btnAttack1"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:backgroundTint="#EF4444"
                android:text="Ataque Directo"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAttack2"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:backgroundTint="#3B82F6"
                android:text="Golpe Crítico"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAttack3"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:backgroundTint="#10B981"
                android:text="Recuperar HP"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnAttack4"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_rowWeight="1"
                android:layout_columnWeight="1"
                android:layout_margin="2dp"
                android:backgroundTint="#8B5CF6"
                android:text="Ataque Final"
                android:textSize="11sp" />
        </GridLayout>
    </LinearLayout>

</RelativeLayout>