<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- IMAGEN DE FONDO TORRE MORTAL KOMBAT PAGODA -->
    <ImageView
        android:id="@+id/imgBgTorre"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_torre"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- OVERLAY OSCURO PARA DALE LEGIBILIDAD Y ASPECTO EPICO -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C0A0300" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

            <!-- HEADER TORRE DE COMBATE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pokemon_font"
                android:text="TORRE DE COMBATE"
                android:textColor="#FFCB05"
                android:textSize="22sp"
                android:textStyle="bold"
                android:shadowColor="#FF5722"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="4" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DERROTA A LOS MAESTROS EN CUALQUIER ORDEN Y GANA SUS MEDALLAS"
                android:textColor="#FFD700"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="18dp" />

            <!-- PISO 6: GRAN MAESTRO VÍCTOR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiso6"
                android:layout_width="330dp"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#CC1C1924"
                app:cardCornerRadius="12dp"
                app:cardElevation="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgMaestroPiso6"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#2A2438"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PISO 6 • MAESTRO SUPREMO"
                            android:textColor="#FFD700"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Gran Maestro Víctor"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Pokémon: Rayquaza, Dialga, Giratina"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusPiso6"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ PELEAR"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:padding="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PISO 5: MAESTRO RICARDO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiso5"
                android:layout_width="330dp"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#CC1C1924"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgMaestroPiso5"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#2A2438"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PISO 5 • MAESTRO ELITE"
                            android:textColor="#C084FC"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maestro Ricardo"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Pokémon: Alakazam, Metagross, Mewtwo"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusPiso5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ PELEAR"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:padding="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PISO 4: MAESTRO CAMPA -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiso4"
                android:layout_width="330dp"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#CC1C1924"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgMaestroPiso4"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#2A2438"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PISO 4 • MAESTRO FUEGO"
                            android:textColor="#F97316"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maestro Campa"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Pokémon: Arcanine, Moltres, Charizard"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusPiso4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ PELEAR"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:padding="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PISO 3: MAESTRO EDGAR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiso3"
                android:layout_width="330dp"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#CC1C1924"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgMaestroPiso3"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/maestro_edgar"
                        android:background="#2A2438"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PISO 3 • MAESTRO DRAGÓN"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maestro Edgar"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Pokémon: Dragonite, Salamence, Garchomp"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusPiso3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ PELEAR"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:padding="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PISO 2: MAESTRO EVERARDO -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiso2"
                android:layout_width="330dp"
                android:layout_height="90dp"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="#CC1C1924"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgMaestroPiso2"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/maestro_everardo"
                        android:background="#2A2438"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PISO 2 • MAESTRO FANTASMA"
                            android:textColor="#A855F7"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maestro Everardo"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Pokémon: Mismagius, Chandelure, Gengar"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusPiso2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ PELEAR"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:padding="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- PISO 1: MAESTRO VÍCTOR -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardPiso1"
                android:layout_width="330dp"
                android:layout_height="90dp"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#CC1C1924"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/imgMaestroPiso1"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="#2A2438"
                        android:scaleType="centerCrop"
                        android:importantForAccessibility="no"/>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PISO 1 • MAESTRO LUCHA"
                            android:textColor="#22D3EE"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Maestro Víctor"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3 Pokémon: Machamp, Blaziken, Lucario"
                            android:textColor="#CBD5E1"
                            android:textSize="10sp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvStatusPiso1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚔️ PELEAR"
                        android:textColor="#FF5722"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:padding="6dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>