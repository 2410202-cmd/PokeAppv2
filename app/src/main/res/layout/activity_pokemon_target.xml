<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/battle">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#60000000" />

    <!-- CABECERA: TIEMPO, PUNTOS Y VIDAS -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_margin="16dp"
        android:background="#CC0F172A"
        android:orientation="horizontal"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="⏳ Tiempo: 30s"
            android:textColor="#FACC15"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🎯 Puntos: 0"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLives"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❤️ Vidas: 3"
            android:textColor="#F43F5E"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ÁREA DE JUEGO (DONDE APARECEN LOS OBJETIVOS) -->
    <FrameLayout
        android:id="@+id/gameArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnStartGame"
        android:layout_below="@id/headerContainer"
        android:layout_margin="16dp">

        <ImageView
            android:id="@+id/ivTarget"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:visibility="invisible" />
    </FrameLayout>

    <!-- BOTÓN INICIAR / REINICIAR -->
    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:backgroundTint="#0284C7"
        android:text="🎯 INICIAR JUEGO"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="12dp" />

</RelativeLayout>