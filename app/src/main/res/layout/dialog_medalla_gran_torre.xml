<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1B1726"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <!-- TITULO DE LA MEDALLA -->
    <TextView
        android:id="@+id/tvMedalDialogTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pokemon_font"
        android:text="¡MEDALLA CONQUISTADA!"
        android:textColor="#FFD700"
        android:textSize="18sp"
        android:textStyle="bold"
        android:shadowColor="#FF5722"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- MEDALLA GRANDE CON RESPLANDOR -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/btn_cyber_circle"
        android:gravity="center">

        <TextView
            android:id="@+id/tvBigMedalEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="🏅"
            android:textSize="72sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMedalMaestroName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MAESTRO DERROTADO"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/tvMedalDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Has derrotado a sus 3 Pokémon y obtenido la Medalla Oficial de la Torre."
        android:textColor="#CBD5E1"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/btnClaimMedal"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:backgroundTint="#FFD700"
        android:text="¡RECLAMAR MEDALLA!"
        android:textColor="#000000"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>