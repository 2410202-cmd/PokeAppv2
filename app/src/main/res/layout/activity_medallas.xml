<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#152033"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🏅 MEDALLERO KANTO 🏅"
        android:textColor="#FFCB05"
        android:textSize="22sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:columnCount="2">

        <Button
            android:id="@+id/btnBadge1"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#795548"
            android:text="🪨\nMedalla Roca\n(Desbloqueada)" />

        <Button
            android:id="@+id/btnBadge2"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#00BCD4"
            android:text="💧\nMedalla Cascada\n(Desbloqueada)" />

        <Button
            android:id="@+id/btnBadge3"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#424242"
            android:text="🔒\nMedalla Trueno\n(Bloqueada)" />

        <Button
            android:id="@+id/btnBadge4"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_columnWeight="1"
            android:layout_margin="8dp"
            android:backgroundTint="#424242"
            android:text="🔒\nMedalla Arcoíris\n(Bloqueada)" />
    </GridLayout>

</LinearLayout>