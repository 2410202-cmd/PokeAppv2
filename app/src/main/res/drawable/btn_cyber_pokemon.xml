<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Presionado (Efecto Neón Encendido) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#400284C7"
                android:startColor="#6038BDF8" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2.5dp"
                android:color="#00FFFF" />
        </shape>
    </item>

    <!-- Normal (Cyberpunk Semitransparente) -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:endColor="#D90F172A"
                android:startColor="#E61E293B" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1.5dp"
                android:color="#38BDF8" />
        </shape>
    </item>
</selector>