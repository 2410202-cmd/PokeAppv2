<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#806366F1">

    <item>
        <shape android:shape="rectangle">
            <!-- Degradado neón azul a morado espacial -->
            <gradient
                android:angle="45"
                android:startColor="#331E1B4B"
                android:endColor="#4D312E81" />

            <!-- Esquinas asimétricas estilo insignia -->
            <corners
                android:topLeftRadius="28dp"
                android:topRightRadius="8dp"
                android:bottomLeftRadius="8dp"
                android:bottomRightRadius="28dp" />

            <!-- Borde resplandeciente Cyan/Azul elétrico -->
            <stroke
                android:width="1.5dp"
                android:color="#818CF8" />
        </shape>
    </item>
</ripple>