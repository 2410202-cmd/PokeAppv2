<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Estado ENCENDIDO (al tocar, desplazar o presionar el botón) -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4038BDF8" /> <!-- Azul brillante translúcido -->
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="#00FFFF" /> <!-- Borde cian neón encendido -->
        </shape>
    </item>

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#4038BDF8" />
            <corners android:radius="14dp" />
            <stroke
                android:width="2.5dp"
                android:color="#00FFFF" />
        </shape>
    </item>

    <!-- Estado NORMAL (Borde azul cian individual para cada botón) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC0F172A" /> <!-- Fondo oscuro semitransparente -->
            <corners android:radius="14dp" />
            <stroke
                android:width="1.5dp"
                android:color="#38BDF8" /> <!-- Contorno azul cian individual -->
        </shape>
    </item>

</selector>