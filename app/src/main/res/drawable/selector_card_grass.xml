<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient
                android:angle="135"
                android:startColor="#FF76FF03"
                android:endColor="#FF00E676" />
            <stroke android:width="3dp" android:color="#FFE8F5E9" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card_grass" />
</selector>