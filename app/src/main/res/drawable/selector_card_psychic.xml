<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="35dp" />
            <gradient
                android:angle="135"
                android:startColor="#FFE040FB"
                android:endColor="#FF7C4DFF" />
            <stroke android:width="3dp" android:color="#FFF3E5F5" />
        </shape>
    </item>
    <item android:drawable="@drawable/bg_card_psychic" />
</selector>