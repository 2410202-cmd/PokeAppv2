<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sombra/Borde exterior oscuro -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#580808" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Cuerpo principal con degradado estilo Pokédex -->
    <item
        android:bottom="4dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#B91C1C"
                android:startColor="#EF4444" />
            <stroke
                android:width="2dp"
                android:color="#7F1D1D" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Línea de brillo cristalino superior -->
    <item
        android:bottom="10dp"
        android:left="6dp"
        android:right="6dp"
        android:top="5dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#00FFFFFF"
                android:startColor="#40FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Remaches / Puntos metálicos en esquinas -->
    <item android:width="5dp" android:height="5dp" android:gravity="top|left" android:left="8dp" android:top="8dp">
        <shape android:shape="oval"><solid android:color="#FCA5A5" /></shape>
    </item>
    <item android:width="5dp" android:height="5dp" android:gravity="top|right" android:right="8dp" android:top="8dp">
        <shape android:shape="oval"><solid android:color="#FCA5A5" /></shape>
    </item>
    <item android:width="5dp" android:height="5dp" android:gravity="bottom|left" android:bottom="10dp" android:left="8dp">
        <shape android:shape="oval"><solid android:color="#FCA5A5" /></shape>
    </item>
    <item android:width="5dp" android:height="5dp" android:gravity="bottom|right" android:bottom="10dp" android:right="8dp">
        <shape android:shape="oval"><solid android:color="#FCA5A5" /></shape>
    </item>

</layer-list>